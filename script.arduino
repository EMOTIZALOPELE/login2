#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <ESP32Servo.h>

const char* ssid = "ITR3-6";
const char* password = "archivado";

// Configuración del servo
Servo servoVentana;
const uint8_t pinServoVentana = 2;
bool ventanaAbierta = false;

// Configuración de la API
const char* serverName = "http://tudominio.com/horarios/getEstadoVentana";
const int intervaloConsulta = 30000; // Consultar cada 30 segundos

// Configuración del servidor web para control manual
WebServer server(80);

void handleRoot() {
  String html = "<html><body>";
  html += "<h1>Control de Ventana</h1>";
  html += "<p>Estado actual: " + String(ventanaAbierta ? "Abierta" : "Cerrada") + "</p>";
  html += "<p><a href='/abrir'>Abrir Ventana</a></p>";
  html += "<p><a href='/cerrar'>Cerrar Ventana</a></p>";
  server.send(200, "text/html", html);
}

void handleAbrir() {
  servoVentana.write(180);
  ventanaAbierta = true;
  server.send(200, "text/plain", "Ventana abierta");
}

void handleCerrar() {
  servoVentana.write(0);
  ventanaAbierta = false;
  server.send(200, "text/plain", "Ventana cerrada");
}

void setup() {
  Serial.begin(115200);
  
  // Configurar servo
  servoVentana.attach(pinServoVentana);
  servoVentana.write(0); // Iniciar cerrado

  // Conectar WiFi
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  
  Serial.println("\nWiFi conectado");
  Serial.print("Dirección IP: ");
  Serial.println(WiFi.localIP());

  // Configurar rutas del servidor web
  server.on("/", handleRoot);
  server.on("/abrir", handleAbrir);
  server.on("/cerrar", handleCerrar);
  server.begin();
}

void loop() {
  server.handleClient();
  
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    
    // Agregar el ID del diseño como parámetro
    String url = String(serverName) + "?diseno_id=1"; // Cambiar el ID según corresponda
    http.begin(url);
    
    int httpCode = http.GET();
    if (httpCode == 200) {
      String payload = http.getString();
      
      // Parsear JSON
      DynamicJsonDocument doc(1024);
      deserializeJson(doc, payload);
      
      // Obtener hora actual y horarios
      String horaActual = doc["hora_actual"];
      String apertura = doc["ventana_apertura"];
      String cierre = doc["ventana_cierre"];
      String diasSemana = doc["dias_semana"];
      
      // Obtener el día actual
      String diaActual = getDiaActual();
      
      // Verificar si el día actual está en los días programados
      if (diasSemana.indexOf(diaActual) >= 0) {
        // Comparar horas
        if (horaActual >= apertura && horaActual <= cierre && !ventanaAbierta) {
          servoVentana.write(180);
          ventanaAbierta = true;
          Serial.println("Ventana abierta automáticamente");
        } else if ((horaActual < apertura || horaActual > cierre) && ventanaAbierta) {
          servoVentana.write(0);
          ventanaAbierta = false;
          Serial.println("Ventana cerrada automáticamente");
        }
      }
    }
    http.end();
  }
  
  delay(intervaloConsulta);
}

String getDiaActual() {
  const char* dias[] = {"Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"};
  time_t now = time(nullptr);
  struct tm* timeinfo = localtime(&now);
  return String(dias[timeinfo->tm_wday]);
}